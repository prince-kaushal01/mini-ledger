# PostgreSQL used by Docker Compose and the API.
# Copy this file to .env in the repository root.
POSTGRES_DB=miniledger
POSTGRES_USER=miniledger
POSTGRES_PASSWORD=miniledger
DATABASE_URL=postgresql://miniledger:miniledger@localhost:49160/miniledger?schema=public

# API
PORT=4000
JWT_SECRET=replace-with-a-long-random-development-secret
OTP_TTL_MINUTES=5
